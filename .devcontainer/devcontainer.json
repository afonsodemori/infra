{
  "name": "infra",
  "dockerComposeFile": "compose.yml",
  "service": "app",
  "workspaceFolder": "/infra",

  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "mkhl.shfmt",
        "redhat.vscode-yaml",
        "eamodio.gitlens",
        "Anthropic.claude-code"
      ]
    }
  },

  "postCreateCommand": "bash .devcontainer/install.sh"
}
